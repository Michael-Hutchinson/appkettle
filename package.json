{
  "name": "appkettle",
  "version": "0.1.0",
  "description": "Local control bridge for the AppKettle smart kettle (defunct vendor). Reverse-engineered Across protocol over TCP/6002. Exposes an MCP server.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Michael Hutchinson",
  "homepage": "https://github.com/Michael-Hutchinson/appkettle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Michael-Hutchinson/appkettle.git"
  },
  "bugs": {
    "url": "https://github.com/Michael-Hutchinson/appkettle/issues"
  },
  "keywords": [
    "appkettle",
    "smart-kettle",
    "mcp",
    "model-context-protocol",
    "iot",
    "reverse-engineering",
    "claude"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "appkettle-mcp": "./dist/mcp.js",
    "appkettle-mcp-http": "./dist/mcp-http.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/mcp.js dist/mcp-http.js dist/cli.js",
    "dev": "tsx src/mcp.ts",
    "dev:http": "tsx src/mcp-http.ts",
    "cli": "tsx src/cli.ts",
    "discover": "tsx src/discovery.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
